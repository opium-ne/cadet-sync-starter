# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import in client components.
# Used for exactly one thing in Phase 1: minting signed PDF URLs after an entitlement check.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seconds a signed PDF link stays valid
SIGNED_URL_TTL_SECONDS=60

# Optional, for email notifications later
RESEND_API_KEY=
EMAIL_FROM="Cadet Sync <no-reply@your-domain>"
